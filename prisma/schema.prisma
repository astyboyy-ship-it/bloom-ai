// Workflow-Aware Infrastructure Architect — data model
// pgvector is enabled through the postgresqlExtensions preview feature; the
// HNSW index on DocumentChunk.embedding lives in the init migration SQL.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum WorkspaceStatus {
  DRAFT
  ARCHITECTING
  READY
  FAILED
}

enum AgentTopology {
  SINGLE_AGENT
  HIERARCHICAL
  PIPELINE
}

enum ModelTier {
  FAST
  BALANCED
  DEEP
}

enum IngestStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model User {
  id         String      @id @default(cuid())
  email      String      @unique
  name       String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  workspaces Workspace[]
}

model Workspace {
  id                  String          @id @default(cuid())
  name                String
  slug                String          @unique
  workflowDescription String          @db.Text
  domain              String?
  summary             String?         @db.Text
  status              WorkspaceStatus @default(DRAFT)
  errorMessage        String?         @db.Text

  // Outbound webhook fired when a workflow run completes (HMAC-SHA256 signed).
  webhookUrl    String?
  webhookSecret String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  config       WorkflowConfig?
  apiKeys      ApiKey[]
  vectorStores VectorStoreReference[]
  requests     GatewayRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model WorkflowConfig {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  version            Int           @default(1)
  topology           AgentTopology
  topologyRationale  String        @db.Text
  orchestratorPrompt String        @db.Text
  // JSON Schema (as JSON) for the workflow's final deliverable.
  outputSchema       Json
  // [{ taskType, tier, rationale }]
  routingRules       Json
  // [{ kind, name, purpose, config: { key: value } }]
  toolIntegrations   Json
  // { enabled, strategy, chunkSize, chunkOverlap, rationale }
  ragStrategy        Json

  maxTokensPerRequest Int @default(4096)
  monthlyTokenBudget  Int @default(2000000)

  // The untouched spec returned by the architect model, for audit/regeneration.
  rawSpec Json

  agents AgentRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgentRole {
  id       String         @id @default(cuid())
  configId String
  config   WorkflowConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  name           String
  role           String // researcher | auditor | executor | planner | specialist
  responsibility String    @db.Text
  systemPrompt   String    @db.Text
  outputSchema   Json?
  tier           ModelTier
  // Primary OpenRouter model slug + ordered fallbacks. Editable (hot-swap).
  model          String
  fallbackModels String[]
  temperature    Float     @default(0.3)
  maxTokens      Int       @default(2048)
  tools          String[]
  position       Int       @default(0)

  requests GatewayRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([configId, name])
  @@index([configId, position])
}

model VectorStoreReference {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name           String
  embeddingModel String
  dimensions     Int          @default(1536)
  chunkStrategy  String
  chunkSize      Int
  chunkOverlap   Int
  status         IngestStatus @default(PENDING)
  documentCount  Int          @default(0)

  chunks DocumentChunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, name])
}

model DocumentChunk {
  id         String               @id @default(cuid())
  storeId    String
  store      VectorStoreReference @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sourceName String
  chunkIndex Int
  content    String               @db.Text
  metadata   Json?
  // Written and queried with raw SQL (Prisma has no native vector type).
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime             @default(now())

  @@index([storeId])
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name       String
  // First characters of the key, shown in the UI so users can tell keys apart.
  prefix     String
  // SHA-256 of the full key. The plaintext key is shown exactly once.
  hashedKey  String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?

  requests GatewayRequest[]

  createdAt DateTime @default(now())

  @@index([workspaceId])
}

// One row per upstream completion; drives token budget enforcement and usage views.
model GatewayRequest {
  id          String     @id @default(cuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  apiKeyId    String?
  apiKey      ApiKey?    @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  agentRoleId String?
  agentRole   AgentRole? @relation(fields: [agentRoleId], references: [id], onDelete: SetNull)

  source           String // gateway | playground | api_run
  requestedModel   String
  servedModel      String?
  attempts         Int     @default(1)
  promptTokens     Int     @default(0)
  completionTokens Int     @default(0)
  latencyMs        Int     @default(0)
  status           String // ok | error | budget_exceeded
  error            String? @db.Text

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
}

// Bloom AI landing page: "Join The Bloom Network" signups.
model WaitlistLead {
  id        String   @id @default(cuid())
  email     String   @unique
  // Which engine the lead asked about (dealmaker | hunter | gatekeeper | matchmaker | suite).
  engine    String?
  // creator | founder | enterprise
  role      String?
  // access (asked for access) | updates (asked to track development)
  intent    String?
  createdAt DateTime @default(now())

  @@index([engine])
}
