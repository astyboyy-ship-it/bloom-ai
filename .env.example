# --- Database (docker compose up -d postgres) ---
DATABASE_URL="postgresql://wfa:wfa@localhost:5432/workflow_architect?schema=public"

# --- Architect (Claude via Anthropic SDK) ---
ANTHROPIC_API_KEY=""
ARCHITECT_MODEL="claude-opus-5-5"

# --- Gateway upstream: OpenRouter (default) ---
OPENROUTER_API_KEY=""
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# --- Or route through a LiteLLM proxy instead (takes precedence when set) ---
# LITELLM_BASE_URL="http://localhost:4000"
# LITELLM_API_KEY="sk-litellm-local"

# --- Per-tier model chains (comma-separated OpenRouter slugs, primary first) ---
# MODEL_TIER_FAST="anthropic/claude-haiku-5.5,anthropic/claude-haiku-4.5"
# MODEL_TIER_BALANCED="anthropic/claude-sonnet-5.5,anthropic/claude-sonnet-4.6"
# MODEL_TIER_DEEP="anthropic/claude-opus-5.5,anthropic/claude-opus-4.8"

# --- RAG embeddings (any OpenAI-compatible /embeddings endpoint, 1536 dims) ---
EMBEDDINGS_API_KEY=""
# EMBEDDINGS_BASE_URL="https://api.openai.com/v1"
# EMBEDDINGS_MODEL="text-embedding-3-small"

# --- App ---
APP_URL="http://localhost:3000"
DEFAULT_USER_EMAIL="owner@localhost.dev"

# --- IntentPulse Command Center ---
APIFY_API_TOKEN=""
GROQ_API_KEY=""
# false = simulated stream (no Apify credits). true = live Apify Actor runs.
USE_LIVE_APIFY="false"
# Optional Actor overrides (owner/name)
# APIFY_ACTOR_TWITTER="apidojo/tweet-scraper"
# APIFY_ACTOR_INSTAGRAM="apify/instagram-hashtag-scraper"
# APIFY_ACTOR_TIKTOK="clockworks/free-tiktok-scraper"
# APIFY_ACTOR_REDDIT="trudax/reddit-scraper-lite"

# --- Desktop installers ("Download OS" button, /download page) ---
# Option A: direct public URLs to each installer (CDN, Vercel Blob, S3...). Takes precedence.
# DESKTOP_DOWNLOAD_WINDOWS_URL="https://.../Bloom-AI_x64-setup.exe"
# DESKTOP_DOWNLOAD_MAC_URL="https://.../Bloom-AI_universal.dmg"
# Option B: the latest GitHub release built by .github/workflows/desktop.yml.
# Defaults to astyboyy-ship-it/bloom-ai. For a PRIVATE repo, also set GITHUB_TOKEN: a fine-grained token
# with read-only "Contents" access to that one repo. Visitors get a short-lived signed link; the token
# stays on the server.
# DESKTOP_RELEASES_REPO="owner/repo"
# GITHUB_TOKEN=""

# --- Client licensing (Sovereign OS) ---
# Signs and verifies license keys. REQUIRED in production: without it, production accepts no keys and every
# workspace stays in Evaluation. Use a long random value and keep it secret; rotating it invalidates issued keys.
# Issue client keys with: LICENSE_SIGNING_SECRET=... npm run license:issue -- --tier tier3 --org "Client" --days 365
# LICENSE_SIGNING_SECRET=""
# Lets the desk's hidden tier switcher mint 30-day development keys outside local development. Leave unset in production.
# BLOOM_DEV_LICENSES="true"
# Honor Engine Calibration prompt overrides on the server's own model key (otherwise only with the operator's own key).
# COMMAND_ALLOW_PROMPT_OVERRIDES="true"

# --- Bloom Exchange ---
# Signing key for certificates and the HMAC operator seal (falls back to LICENSE_SIGNING_SECRET).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BLOOM_EXCHANGE_SECRET=""
# Upstash Redis (set automatically when you link Upstash in Vercel → Storage). Required in production.
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""
# Daily live-model spend caps in USD: whole deployment, and per access key.
# BLOOM_DAILY_SPEND_CAP_USD="20"
# BLOOM_KEY_DAILY_SPEND_CAP_USD="5"
# Settlement rails: signed webhook for binding certificates, and the USDC wallet for x402.
# BLOOM_EXCHANGE_SETTLEMENT_WEBHOOK_URL=""
# BLOOM_EXCHANGE_X402_PAYTO=""
# BLOOM_EXCHANGE_X402_NETWORK="base"
# Canonical origin printed in certificates, if different from the request host.
# BLOOM_EXCHANGE_PUBLIC_URL=""
# Apex model overrides.
# EXCHANGE_MODEL="claude-sonnet-5-5"
# EXCHANGE_OPENROUTER_MODELS="anthropic/claude-sonnet-5.5,openai/gpt-4o,deepseek/deepseek-chat"
